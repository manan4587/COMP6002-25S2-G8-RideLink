PORT=5000
CLIENT_URL=*
DEV_ALLOW_NO_AUTH=true

# Mapbox real key
MAPBOX_ACCESS_TOKEN=PASTE_YOUR_MAPBOX_ACCESS_TOKEN_HERE
MAPBOX_COUNTRY=AU
MAPBOX_DEFAULT_PROXIMITY=115.8575,-31.9505

# Firebase Admin SDK - use either one-line JSON or separate values
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=PASTE_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=PASTE_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"
